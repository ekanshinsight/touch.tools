# Copy this file to .env and fill in your own values.
# .env is already listed in .gitignore - never commit it.

# Which endpoint family to use: meta | messages | chat
PROVIDER=meta

# The endpoint root, no trailing slash.
#   Meta Model API   https://api.meta.ai
BASE_URL=

# The model name the endpoint expects (for example a Muse model).
MODEL=

# Your key. Leave blank here and put the real value only in .env.
API_KEY=
